@page "/auslagen"
@attribute [Authorize(Policy = Richtlinien.Bearbeiten)]
@implements IDisposable
@inject PlanungsZustand Zustand

<PageTitle>Auslagen</PageTitle>

<h1>Auslagen</h1>

<p class="keindruck">
    Verpflegung (z. B. Essen und Getränke zur Prüfung), Anschaffungen (z. B. Westen für die Ausbilder) und Sonstiges.
    Wer etwas ausgelegt hat, bekommt es erstattet; ohne Person wurde direkt aus der Vereinskasse bezahlt.
</p>

<div class="werkzeuge keindruck">
    <button @onclick="Neu">Neue Auslage</button>
    <label>
        Ansicht
        <select @bind="_ansicht">
            <option value="liste">Übersicht</option>
            <option value="personen">Erstattung je Person (zum Unterschreiben)</option>
        </select>
    </label>
    <label><input type="checkbox" @bind="_nurOffen" /> nur noch nicht erstattete</label>
    <label>erstattet am <input type="date" @bind="_datum" /></label>
    <button onclick="window.print()">Drucken</button>
</div>

@if (_f is not null)
{
    <section class="formular keindruck">
        <h2>@(_f.Id is null ? "Neue Auslage" : "Auslage bearbeiten")</h2>
        <div class="felder">
            <label>Datum <input type="date" @bind="_f.Datum" /></label>
            <label>
                Art
                <select @bind="_f.Art">
                    <option value="@Auslagenart.Verpflegung">Verpflegung</option>
                    <option value="@Auslagenart.Anschaffung">Anschaffung</option>
                    <option value="@Auslagenart.Sonstiges">Sonstiges</option>
                </select>
            </label>
            <label>Wofür <input @bind="_f.Bezeichnung" placeholder="z. B. Brötchen und Getränke" /></label>
            <label>Betrag (€) <input type="number" step="0.01" min="0" style="width:7rem" @bind="_f.Betrag" /></label>
            <label>
                Ausgelegt von
                <select @bind="_f.PersonId">
                    <option value="0">– Vereinskasse –</option>
                    @foreach (var p in _personen) { <option value="@p.Id">@p.Anzeigename</option> }
                </select>
            </label>
            <label>
                Anlass
                <input list="anlaesse" @bind="_f.Anlass" placeholder="z. B. Prüfung September" />
                <datalist id="anlaesse">
                    @foreach (var a in _auslagen.Select(x => x.Anlass).Where(x => x is not null).Distinct()) { <option value="@a"></option> }
                </datalist>
            </label>
            <label>Bemerkung <input @bind="_f.Bemerkung" /></label>
        </div>
        <div class="reihe">
            <label><input type="checkbox" @bind="_f.Beleg" /> Beleg liegt vor</label>
        </div>
        <div class="werkzeuge">
            <button class="primaer" @onclick="Speichern">Speichern</button>
            <button @onclick="() => { _f = null; _meldung = null; }">Abbrechen</button>
        </div>
    </section>
}

@if (_meldung is not null)
{
    <p class="befund rot keindruck">@_meldung</p>
}

@{
    var sichtbar = _auslagen.Where(a => !_nurOffen || (a.PersonId is not null && a.ErstattetAm is null)).ToList();
}

@if (_auslagen.Count == 0)
{
    <p>Noch keine Auslagen erfasst.</p>
}
else if (_ansicht == "liste")
{
    <p class="nurdruck">@Zustand.Kursbezeichnung · Stand @DateTime.Today.ToString("dd.MM.yyyy")</p>
    <table class="liste">
        <thead>
            <tr><th>Datum</th><th>Art</th><th>Wofür</th><th>Anlass</th><th>Ausgelegt von</th><th>Beleg</th><th class="zahl">Betrag</th><th>erstattet</th><th class="keindruck"></th></tr>
        </thead>
        <tbody>
            @foreach (var a in sichtbar)
            {
                <tr>
                    <td>@a.Datum.ToString("dd.MM.yyyy")</td>
                    <td>@PlanungsZustand.ArtText(a.Art)</td>
                    <td>@a.Bezeichnung @if (a.Bemerkung is not null) { <br /><small class="legende">@a.Bemerkung</small> }</td>
                    <td>@a.Anlass</td>
                    <td>@(a.PersonId is null ? "Vereinskasse" : Name(a.PersonId))</td>
                    <td>@(a.BelegLiegtVor ? "ja" : "fehlt")</td>
                    <td class="zahl">@Gebuehrenregel.Euro(a.Betrag)</td>
                    <td>@ErstattetZelle(a)</td>
                    <td class="keindruck">
                        <button class="klein" @onclick="() => Bearbeiten(a)">ändern</button>
                        @if (_loeschen == a.Id)
                        {
                            <button class="klein gefahr" @onclick="() => Loeschen(a)">wirklich löschen</button>
                            <button class="klein" @onclick="() => _loeschen = null">nein</button>
                        }
                        else
                        {
                            <button class="klein" @onclick="() => _loeschen = a.Id">löschen</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            @foreach (var art in sichtbar.GroupBy(a => a.Art).OrderBy(g => g.Key))
            {
                <tr><th colspan="6">@PlanungsZustand.ArtText(art.Key)</th><th class="zahl">@Gebuehrenregel.Euro(art.Sum(a => a.Betrag))</th><th colspan="2"></th></tr>
            }
            <tr><th colspan="6">Summe</th><th class="zahl">@Gebuehrenregel.Euro(sichtbar.Sum(a => a.Betrag))</th><th colspan="2"></th></tr>
            <tr><th colspan="6">davon noch zu erstatten</th><th class="zahl">@Gebuehrenregel.Euro(sichtbar.Where(a => a.PersonId is not null && a.ErstattetAm is null).Sum(a => a.Betrag))</th><th colspan="2"></th></tr>
        </tfoot>
    </table>
    @if (sichtbar.Any(a => !a.BelegLiegtVor))
    {
        <p class="befund gelb keindruck">Bei @sichtbar.Count(a => !a.BelegLiegtVor) Auslagen fehlt noch der Beleg.</p>
    }
}
else
{
    @foreach (var person in sichtbar.Where(a => a.PersonId is not null).GroupBy(a => a.PersonId!.Value))
    {
        var p = _personen.FirstOrDefault(x => x.Id == person.Key);
        <section class="abrechnung">
            <h2>Auslagenerstattung @(p?.VollerName ?? Name(person.Key))</h2>
            <p class="nurdruck">@Zustand.Kursbezeichnung · Stand @DateTime.Today.ToString("dd.MM.yyyy")</p>
            <table class="liste">
                <thead><tr><th>Datum</th><th>Art</th><th>Wofür</th><th>Anlass</th><th>Beleg</th><th class="zahl">Betrag</th><th>erstattet</th></tr></thead>
                <tbody>
                    @foreach (var a in person)
                    {
                        <tr>
                            <td>@a.Datum.ToString("dd.MM.yyyy")</td>
                            <td>@PlanungsZustand.ArtText(a.Art)</td>
                            <td>@a.Bezeichnung</td>
                            <td>@a.Anlass</td>
                            <td>@(a.BelegLiegtVor ? "ja" : "fehlt")</td>
                            <td class="zahl">@Gebuehrenregel.Euro(a.Betrag)</td>
                            <td>@ErstattetZelle(a)</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr><th colspan="5">Summe</th><th class="zahl">@Gebuehrenregel.Euro(person.Sum(a => a.Betrag))</th><th></th></tr>
                    <tr><th colspan="5">noch zu erstatten</th><th class="zahl">@Gebuehrenregel.Euro(person.Where(a => a.ErstattetAm is null).Sum(a => a.Betrag))</th><th></th></tr>
                </tfoot>
            </table>
            <p class="unterschrift nurdruck">Belege anbei. Datum, Unterschrift: ______________________________</p>
        </section>
    }
    @if (!sichtbar.Any(a => a.PersonId is not null))
    {
        <p>Keine Auslagen, die an eine Person zu erstatten sind.</p>
    }
}

@code {
    private sealed class Formular
    {
        public int? Id { get; init; }
        public DateOnly Datum { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public Auslagenart Art { get; set; } = Auslagenart.Verpflegung;
        public string Bezeichnung { get; set; } = "";
        public decimal? Betrag { get; set; }
        public int PersonId { get; set; }
        public string? Anlass { get; set; }
        public bool Beleg { get; set; } = true;
        public DateOnly? ErstattetAm { get; set; }
        public string? Bemerkung { get; set; }
    }

    private List<AuslageDaten> _auslagen = [];
    private List<PersonDaten> _personen = [];
    private Formular? _f;
    private string _ansicht = "liste";
    private bool _nurOffen;
    private DateOnly _datum = DateOnly.FromDateTime(DateTime.Today);
    private int? _loeschen;
    private string? _meldung;

    private string Name(int? personId) => _personen.FirstOrDefault(p => p.Id == personId)?.Anzeigename ?? "";

    private RenderFragment ErstattetZelle(AuslageDaten a) => __builder =>
    {
        if (a.PersonId is null)
        {
            <span>–</span>
        }
        else
        {
            <label class="keindruck">
                <input type="checkbox" checked="@(a.ErstattetAm is not null)" @onchange="e => Erstattet(a, (bool)e.Value!)" />
                @a.ErstattetAm?.ToString("dd.MM.yyyy")
            </label>
            <span class="nurdruck">@(a.ErstattetAm?.ToString("dd.MM.yyyy") ?? "offen")</span>
        }
    };

    private void Laden()
    {
        _auslagen = Zustand.Auslagen();
        _personen = Zustand.Personen();
    }

    private void Neu()
    {
        _f = new Formular();
        _meldung = null;
    }

    private void Bearbeiten(AuslageDaten a)
    {
        _f = new Formular
        {
            Id = a.Id, Datum = a.Datum, Art = a.Art, Bezeichnung = a.Bezeichnung, Betrag = a.Betrag, PersonId = a.PersonId ?? 0,
            Anlass = a.Anlass, Beleg = a.BelegLiegtVor, ErstattetAm = a.ErstattetAm, Bemerkung = a.Bemerkung,
        };
        _meldung = null;
    }

    private void Speichern()
    {
        if (_f is null) return;
        var f = _f;
        if (f.Betrag is null)
        {
            _meldung = "Bitte den Betrag eintragen.";
            return;
        }
        Ausfuehren(() => Zustand.AuslageSpeichern(new AuslageDaten(f.Id, f.Datum, f.Art, f.Bezeichnung, f.Betrag.Value,
            f.PersonId == 0 ? null : f.PersonId, f.Anlass, f.Beleg, f.PersonId == 0 ? null : f.ErstattetAm, f.Bemerkung)));
        if (_meldung is null) _f = null;
    }

    private void Loeschen(AuslageDaten a)
    {
        Ausfuehren(() => Zustand.AuslageLoeschen(a));
        _loeschen = null;
    }

    private void Erstattet(AuslageDaten a, bool an) => Ausfuehren(() => Zustand.AuslageErstattetSetzen(a, an ? _datum : null));

    private void Ausfuehren(Action aktion)
    {
        try
        {
            aktion();
            _meldung = null;
        }
        catch (InvalidOperationException ex)
        {
            _meldung = ex.Message;
        }
        Laden();
    }

    protected override void OnInitialized()
    {
        Laden();
        Zustand.Geaendert += Aktualisieren;
    }

    private void Aktualisieren() => InvokeAsync(() => { Laden(); StateHasChanged(); });
    public void Dispose() => Zustand.Geaendert -= Aktualisieren;
}
