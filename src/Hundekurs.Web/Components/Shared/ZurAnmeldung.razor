@inject NavigationManager Navigation

@code {
    // Nicht angemeldet: zur Anmeldeseite und danach zurück hierher. forceLoad, weil die Anmeldung eine normale Formularseite ist.
    protected override void OnInitialized()
    {
        var ziel = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"anmelden?ReturnUrl={Uri.EscapeDataString(ziel)}", forceLoad: true);
    }
}
